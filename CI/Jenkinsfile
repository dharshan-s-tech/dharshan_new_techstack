pipeline {

    agent any


    /*
     * ================================================================
     * CAG WEBSITE V2 - CI PIPELINE
     * ================================================================
     *
     * Repository:
     *
     *     https://github.com/Keerthiga-S/CAG_Website_V2.git
     *
     * CI FLOW:
     *
     *     1.  Checkout Code
     *     2.  Check Raw Files
     *     3.  SonarQube Scan
     *     4.  Create CI Network
     *     5.  Start PostgreSQL
     *     6.  Build Backend Docker Image
     *     7.  Build Frontend Docker Image
     *     8.  Trivy Backend Image Scan
     *     9.  Trivy Frontend Image Scan
     *     10. Start Backend Test Container
     *     11. Backend Health Check
     *     12. Start Frontend Test Container
     *     13. Frontend Health Check
     *     14. Trivy Backend Filesystem Scan
     *     15. Push Images to Docker Hub
     *     16. Publish Build Information
     *     17. Deploy Prod
     *
     *
     * IMPORTANT:
     *
     *     CI NEVER connects to the production PostgreSQL database.
     *
     *     CI uses an isolated temporary PostgreSQL container.
     *
     *     CI creates a unique Docker network per build.
     *
     *     CI builds immutable Docker images using Git SHA.
     *
     *     CI does not modify developer source code.
     *
     *     CI does not bypass TypeScript / Next.js build errors.
     *
     *     CD deploys the exact Docker images created by CI.
     *
     * ================================================================
     */


    environment {


        /*
         * ============================================================
         * DOCKER HUB
         * ============================================================
         */

        DOCKERHUB_CREDENTIALS_ID = "dockerhub-creds"

        DOCKERHUB_NAMESPACE = "iitmpravartak"

        BACKEND_IMAGE = "iitmpravartak/cag-website-v2-backend"

        FRONTEND_IMAGE = "iitmpravartak/cag-website-v2-frontend"


        /*
         * ============================================================
         * GITHUB
         * ============================================================
         */

        GITHUB_CREDENTIALS_ID = "github-token"


        /*
         * ============================================================
         * SONARQUBE
         * ============================================================
         */

        SONARQUBE_SERVER = "sonar-server"

        SONAR_SCANNER = "SonarScanner"

        SONAR_PROJECT_KEY = "CAG_Website_V2"

        SONAR_PROJECT_NAME = "CAG Website V2"


        /*
         * ============================================================
         * CI NETWORK
         * ============================================================
         */

        CI_NETWORK = "cag-website-v2-ci-${BUILD_NUMBER}"


        /*
         * ============================================================
         * CI CONTAINERS
         * ============================================================
         */

        POSTGRES_CONTAINER = "cag-website-v2-ci-postgres-${BUILD_NUMBER}"

        BACKEND_CONTAINER = "cag-website-v2-ci-backend-${BUILD_NUMBER}"

        FRONTEND_CONTAINER = "cag-website-v2-ci-frontend-${BUILD_NUMBER}"


        /*
         * ============================================================
         * CI POSTGRESQL
         * ============================================================
         *
         * TEST DATABASE ONLY.
         *
         * NEVER production credentials.
         * ============================================================
         */

        POSTGRES_IMAGE = "postgres:17"

        POSTGRES_DB = "cag_test"

        POSTGRES_USER = "cag_test"

        POSTGRES_PASSWORD = "cag_test_password"


        /*
         * ============================================================
         * TRIVY
         * ============================================================
         */

        TRIVY_CACHE_DIR = "${WORKSPACE}/.trivy-cache"

    }


    stages {


        /*
         * ============================================================
         * 1. CHECKOUT CODE
         * ============================================================
         */

        stage("1. Checkout Code") {

            steps {

                echo """
============================================================
CAG WEBSITE V2 - CHECKOUT
============================================================
"""


                checkout scm


                script {

                    /*
                     * Get the exact commit after checkout.
                     *
                     * We intentionally use a Jenkins runtime variable
                     * instead of declaring IMAGE_TAG/GIT_SHA as empty
                     * Declarative environment variables.
                     */


                    def gitSha = sh(
                        script: "git rev-parse --short=12 HEAD",
                        returnStdout: true
                    ).trim()


                    /*
                     * Make the values available to later stages.
                     */


                    env.GIT_SHA = gitSha

                    env.IMAGE_TAG = gitSha


                    echo ""

                    echo "Repository:"
                    echo "${env.GIT_URL ?: 'Jenkins SCM'}"


                    echo ""

                    echo "Branch:"
                    echo "${env.BRANCH_NAME}"


                    echo ""

                    echo "Pull Request:"
                    echo "${env.CHANGE_ID ?: 'No'}"


                    echo ""

                    echo "Git Commit:"
                    echo "${env.GIT_COMMIT}"


                    echo ""

                    echo "Git SHA:"
                    echo "${env.GIT_SHA}"


                    echo ""

                    echo "Image Tag:"
                    echo "${env.IMAGE_TAG}"


                    echo ""

                    echo "Backend Image:"
                    echo "${BACKEND_IMAGE}:${env.IMAGE_TAG}"


                    echo ""

                    echo "Frontend Image:"
                    echo "${FRONTEND_IMAGE}:${env.IMAGE_TAG}"
                }
            }
        }


        /*
         * ============================================================
         * 2. CHECK RAW FILES
         * ============================================================
         */

        stage("2. Check Raw Files") {

            steps {

                echo """
============================================================
CAG WEBSITE V2 - SOURCE VALIDATION
============================================================
"""


                sh '''
                    set -eu


                    echo ""
                    echo "Current directory:"
                    pwd


                    echo ""
                    echo "Git status:"
                    git status --short


                    echo ""
                    echo "Top-level files:"
                    ls -la


                    echo ""
                    echo "Checking frontend Dockerfile..."

                    test -f Dockerfile


                    echo ""
                    echo "Checking backend directory..."

                    test -d back_end


                    echo ""
                    echo "Checking backend Dockerfile..."

                    test -f back_end/Dockerfile


                    echo ""
                    echo "Checking package.json..."

                    test -f package.json


                    echo ""
                    echo "Checking package-lock.json..."

                    test -f package-lock.json


                    echo ""
                    echo "Checking docker-compose.yml..."

                    test -f docker-compose.yml


                    echo ""
                    echo "Checking frontend source..."

                    test -d src


                    echo ""
                    echo "Checking backend application..."

                    test -d back_end/app


                    echo ""
                    echo "Checking Python requirements..."

                    test -f back_end/requirements.txt


                    echo ""
                    echo "Source validation completed successfully."
                '''
            }
        }


        /*
         * ============================================================
         * 3. SONARQUBE SCAN
         * ============================================================
         */

        stage("3. SonarQube Scan") {

            steps {

                echo """
============================================================
CAG WEBSITE V2 - SONARQUBE SCAN
============================================================
"""


                script {

                    def scannerHome = tool "${SONAR_SCANNER}"


                    withSonarQubeEnv("${SONARQUBE_SERVER}") {

                        sh """
                            set -eu


                            echo "SonarQube scanner:"
                            echo "${scannerHome}"


                            echo ""
                            echo "Running SonarQube analysis..."


                            "${scannerHome}/bin/sonar-scanner" \
                                -Dsonar.projectKey="${SONAR_PROJECT_KEY}" \
                                -Dsonar.projectName="${SONAR_PROJECT_NAME}" \
                                -Dsonar.sources=. \
                                -Dsonar.exclusions="**/node_modules/**,**/.next/**,**/__pycache__/**,**/*.jpg,**/*.jpeg,**/*.png,**/*.gif,**/*.svg,**/.git/**"


                            echo ""
                            echo "SonarQube scan completed."
                        """
                    }
                }
            }
        }


        /*
         * ============================================================
         * 4. CREATE CI NETWORK
         * ============================================================
         */

        stage("4. Create CI Network") {

            steps {

                echo """
============================================================
CAG WEBSITE V2 - CREATE CI NETWORK
============================================================
"""


                sh '''
                    set -eu


                    echo "Creating Docker network:"


                    echo "${CI_NETWORK}"


                    docker network create \
                        "${CI_NETWORK}"


                    echo ""

                    echo "Created CI network:"


                    docker network inspect \
                        "${CI_NETWORK}" \
                        --format '{{.Name}}'
                '''
            }
        }


        /*
         * ============================================================
         * 5. START POSTGRESQL
         * ============================================================
         */

        stage("5. Start PostgreSQL") {

            steps {

                echo """
============================================================
CAG WEBSITE V2 - START CI POSTGRESQL
============================================================
"""


                sh '''
                    set -eu


                    echo "Starting PostgreSQL CI container..."


                    docker run -d \
                        --name "${POSTGRES_CONTAINER}" \
                        --network "${CI_NETWORK}" \
                        --network-alias postgres \
                        -e POSTGRES_DB="${POSTGRES_DB}" \
                        -e POSTGRES_USER="${POSTGRES_USER}" \
                        -e POSTGRES_PASSWORD="${POSTGRES_PASSWORD}" \
                        "${POSTGRES_IMAGE}"


                    echo ""

                    echo "PostgreSQL container:"


                    docker ps \
                        --filter "name=${POSTGRES_CONTAINER}"


                    echo ""

                    echo "Waiting for PostgreSQL..."


                    for i in $(seq 1 60)
                    do

                        if docker exec \
                            "${POSTGRES_CONTAINER}" \
                            pg_isready \
                            -U "${POSTGRES_USER}" \
                            -d "${POSTGRES_DB}" \
                            >/dev/null 2>&1
                        then

                            echo "PostgreSQL is READY."

                            exit 0

                        fi


                        echo "PostgreSQL not ready - attempt ${i}/60"


                        sleep 2

                    done


                    echo ""

                    echo "PostgreSQL failed to become ready."


                    docker logs \
                        "${POSTGRES_CONTAINER}" \
                        || true


                    exit 1
                '''
            }
        }


        /*
         * ============================================================
         * 6. BUILD BACKEND DOCKER IMAGE
         * ============================================================
         */

        stage("6. Build Backend Docker Image") {

            steps {

                echo """
============================================================
CAG WEBSITE V2 - BUILD BACKEND IMAGE
============================================================
"""


                sh '''
                    set -eu


                    echo "Git SHA:"
                    echo "${GIT_SHA}"


                    echo ""

                    echo "Image tag:"
                    echo "${IMAGE_TAG}"


                    echo ""

                    echo "Backend image:"
                    echo "${BACKEND_IMAGE}:${IMAGE_TAG}"


                    echo ""

                    echo "Building backend Docker image..."


                    docker build \
                        --pull \
                        -f back_end/Dockerfile \
                        -t "${BACKEND_IMAGE}:${IMAGE_TAG}" \
                        -t "${BACKEND_IMAGE}:ci-${BUILD_NUMBER}" \
                        ./back_end


                    echo ""

                    echo "Checking backend image..."


                    docker image inspect \
                        "${BACKEND_IMAGE}:${IMAGE_TAG}" \
                        >/dev/null


                    echo ""

                    echo "Backend image created successfully."


                    docker images \
                        "${BACKEND_IMAGE}" \
                        --format "table {{.Repository}}\t{{.Tag}}\t{{.Size}}"
                '''
            }
        }


        /*
         * ============================================================
         * 7. BUILD FRONTEND DOCKER IMAGE
         * ============================================================
         */

        stage("7. Build Frontend Docker Image") {

            steps {

                echo """
============================================================
CAG WEBSITE V2 - BUILD FRONTEND IMAGE
============================================================
"""


                sh '''
                    set -eu


                    echo "Git SHA:"
                    echo "${GIT_SHA}"


                    echo ""

                    echo "Image tag:"
                    echo "${IMAGE_TAG}"


                    echo ""

                    echo "Frontend image:"
                    echo "${FRONTEND_IMAGE}:${IMAGE_TAG}"


                    echo ""

                    echo "Building frontend Docker image..."


                    docker build \
                        --pull \
                        -f Dockerfile \
                        -t "${FRONTEND_IMAGE}:${IMAGE_TAG}" \
                        -t "${FRONTEND_IMAGE}:ci-${BUILD_NUMBER}" \
                        .


                    echo ""

                    echo "Checking frontend image..."


                    docker image inspect \
                        "${FRONTEND_IMAGE}:${IMAGE_TAG}" \
                        >/dev/null


                    echo ""

                    echo "Frontend image created successfully."


                    docker images \
                        "${FRONTEND_IMAGE}" \
                        --format "table {{.Repository}}\t{{.Tag}}\t{{.Size}}"
                '''
            }
        }


        /*
         * ============================================================
         * 8. TRIVY BACKEND IMAGE SCAN
         * ============================================================
         */

        stage("8. Trivy Backend Image Scan") {

            steps {

                echo """
============================================================
CAG WEBSITE V2 - TRIVY BACKEND IMAGE SCAN
============================================================
"""


                sh '''
                    set -eu


                    mkdir -p \
                        "${TRIVY_CACHE_DIR}"


                    echo "Scanning backend image:"


                    echo "${BACKEND_IMAGE}:${IMAGE_TAG}"


                    trivy image \
                        --cache-dir "${TRIVY_CACHE_DIR}" \
                        --scanners vuln \
                        --severity HIGH,CRITICAL \
                        --format table \
                        --output "trivy-backend-image-${BUILD_NUMBER}.txt" \
                        --exit-code 0 \
                        --timeout 15m \
                        "${BACKEND_IMAGE}:${IMAGE_TAG}"


                    echo ""

                    echo "Backend Trivy report:"


                    cat \
                        "trivy-backend-image-${BUILD_NUMBER}.txt" \
                        || true


                    echo ""

                    echo "Backend image scan completed."
                '''
            }
        }


        /*
         * ============================================================
         * 9. TRIVY FRONTEND IMAGE SCAN
         * ============================================================
         */

        stage("9. Trivy Frontend Image Scan") {

            steps {

                echo """
============================================================
CAG WEBSITE V2 - TRIVY FRONTEND IMAGE SCAN
============================================================
"""


                sh '''
                    set -eu


                    mkdir -p \
                        "${TRIVY_CACHE_DIR}"


                    echo "Scanning frontend image:"


                    echo "${FRONTEND_IMAGE}:${IMAGE_TAG}"


                    trivy image \
                        --cache-dir "${TRIVY_CACHE_DIR}" \
                        --scanners vuln \
                        --severity HIGH,CRITICAL \
                        --format table \
                        --output "trivy-frontend-image-${BUILD_NUMBER}.txt" \
                        --exit-code 0 \
                        --timeout 15m \
                        "${FRONTEND_IMAGE}:${IMAGE_TAG}"


                    echo ""

                    echo "Frontend Trivy report:"


                    cat \
                        "trivy-frontend-image-${BUILD_NUMBER}.txt" \
                        || true


                    echo ""

                    echo "Frontend image scan completed."
                '''
            }
        }


        /*
         * ============================================================
         * 10. START BACKEND TEST CONTAINER
         * ============================================================
         */

        stage("10. Start Backend Test Container") {

            steps {

                echo """
============================================================
CAG WEBSITE V2 - START BACKEND TEST CONTAINER
============================================================
"""


                sh '''
                    set -eu


                    echo "Starting backend test container..."


                    docker run -d \
                        --name "${BACKEND_CONTAINER}" \
                        --network "${CI_NETWORK}" \
                        -e ENVIRONMENT=production \
                        -e DB_HOST=postgres \
                        -e DB_PORT=5432 \
                        -e DB_NAME="${POSTGRES_DB}" \
                        -e DB_USER="${POSTGRES_USER}" \
                        -e DB_PASSWORD="${POSTGRES_PASSWORD}" \
                        -e DB_SCHEMA=cag_new \
                        "${BACKEND_IMAGE}:${IMAGE_TAG}"


                    echo ""

                    echo "Backend container:"


                    docker ps \
                        --filter "name=${BACKEND_CONTAINER}"


                    echo ""

                    echo "Backend environment configuration:"


                    docker inspect \
                        "${BACKEND_CONTAINER}" \
                        --format '{{range .Config.Env}}{{println .}}{{end}}' \
                        | grep -E '^(ENVIRONMENT|DB_HOST|DB_PORT|DB_NAME|DB_USER|DB_SCHEMA)=' \
                        || true
                '''
            }
        }


        /*
         * ============================================================
         * 11. BACKEND HEALTH CHECK
         * ============================================================
         */

        stage("11. Backend Health Check") {

            steps {

                echo """
============================================================
CAG WEBSITE V2 - BACKEND HEALTH CHECK
============================================================
"""


                sh '''
                    set -eu


                    echo "Waiting for backend..."


                    for i in $(seq 1 60)
                    do

                        if docker run \
                            --rm \
                            --network "${CI_NETWORK}" \
                            curlimages/curl:8.11.1 \
                            -fsS \
                            "http://${BACKEND_CONTAINER}:8000/health" \
                            >/tmp/cag-website-v2-backend-health.json \
                            2>/dev/null
                        then

                            echo ""

                            echo "Backend health check PASSED."


                            echo ""

                            echo "Backend response:"


                            cat \
                                /tmp/cag-website-v2-backend-health.json


                            exit 0

                        fi


                        echo "Backend not ready - attempt ${i}/60"


                        sleep 2

                    done


                    echo ""

                    echo "Backend health check FAILED."


                    echo ""

                    echo "Backend container status:"


                    docker ps -a \
                        --filter "name=${BACKEND_CONTAINER}"


                    echo ""

                    echo "Backend logs:"


                    docker logs \
                        "${BACKEND_CONTAINER}" \
                        || true


                    exit 1
                '''
            }
        }


        /*
         * ============================================================
         * 12. START FRONTEND TEST CONTAINER
         * ============================================================
         */

        stage("12. Start Frontend Test Container") {

            steps {

                echo """
============================================================
CAG WEBSITE V2 - START FRONTEND TEST CONTAINER
============================================================
"""


                sh '''
                    set -eu


                    echo "Starting frontend test container..."


                    docker run -d \
                        --name "${FRONTEND_CONTAINER}" \
                        --network "${CI_NETWORK}" \
                        -e NODE_ENV=production \
                        -e NEXT_PUBLIC_API_URL="http://${BACKEND_CONTAINER}:8000" \
                        "${FRONTEND_IMAGE}:${IMAGE_TAG}"


                    echo ""

                    echo "Frontend container:"


                    docker ps \
                        --filter "name=${FRONTEND_CONTAINER}"
                '''
            }
        }


        /*
         * ============================================================
         * 13. FRONTEND HEALTH CHECK
         * ============================================================
         */

        stage("13. Frontend Health Check") {

            steps {

                echo """
============================================================
CAG WEBSITE V2 - FRONTEND HEALTH CHECK
============================================================
"""


                sh '''
                    set -eu


                    echo "Waiting for frontend..."


                    for i in $(seq 1 60)
                    do

                        if docker run \
                            --rm \
                            --network "${CI_NETWORK}" \
                            curlimages/curl:8.11.1 \
                            -fsS \
                            "http://${FRONTEND_CONTAINER}:3000/" \
                            >/tmp/cag-website-v2-frontend-health.html \
                            2>/dev/null
                        then

                            echo ""

                            echo "Frontend health check PASSED."


                            echo ""

                            echo "Frontend HTTP response received."


                            echo ""

                            echo "HTTP response preview:"


                            head -c 500 \
                                /tmp/cag-website-v2-frontend-health.html \
                                || true


                            echo ""


                            exit 0

                        fi


                        echo "Frontend not ready - attempt ${i}/60"


                        sleep 2

                    done


                    echo ""

                    echo "Frontend health check FAILED."


                    echo ""

                    echo "Frontend container status:"


                    docker ps -a \
                        --filter "name=${FRONTEND_CONTAINER}"


                    echo ""

                    echo "Frontend logs:"


                    docker logs \
                        "${FRONTEND_CONTAINER}" \
                        || true


                    exit 1
                '''
            }
        }


        /*
         * ============================================================
         * 14. TRIVY BACKEND FILESYSTEM SCAN
         * ============================================================
         */

        stage("14. Trivy Backend Filesystem Scan") {

            steps {

                echo """
============================================================
CAG WEBSITE V2 - BACKEND FILESYSTEM SCAN
============================================================
"""


                sh '''
                    set -eu


                    ROOTFS_DIR="${WORKSPACE}/trivy-backend-rootfs"

                    ROOTFS_TAR="${WORKSPACE}/backend-rootfs.tar"


                    rm -rf \
                        "${ROOTFS_DIR}"


                    rm -f \
                        "${ROOTFS_TAR}"


                    mkdir -p \
                        "${ROOTFS_DIR}"


                    echo "Exporting backend container..."


                    docker export \
                        "${BACKEND_CONTAINER}" \
                        -o "${ROOTFS_TAR}"


                    echo ""

                    echo "Extracting backend filesystem..."


                    tar -xf \
                        "${ROOTFS_TAR}" \
                        -C "${ROOTFS_DIR}"


                    echo ""

                    echo "Running Trivy filesystem scan..."


                    mkdir -p \
                        "${TRIVY_CACHE_DIR}"


                    trivy fs \
                        --cache-dir "${TRIVY_CACHE_DIR}" \
                        --scanners vuln \
                        --severity HIGH,CRITICAL \
                        --format table \
                        --output "trivy-backend-rootfs-${BUILD_NUMBER}.txt" \
                        --exit-code 0 \
                        --timeout 15m \
                        "${ROOTFS_DIR}"


                    echo ""

                    echo "Backend filesystem Trivy report:"


                    cat \
                        "trivy-backend-rootfs-${BUILD_NUMBER}.txt" \
                        || true


                    echo ""

                    echo "Backend filesystem scan completed."
                '''
            }
        }


        /*
         * ============================================================
         * 15. PUSH IMAGES TO DOCKER HUB
         * ============================================================
         */

        stage("15. Push Images to Docker Hub") {

            when {

                anyOf {

                    branch "Dev"

                    branch "Prod"

                    changeRequest()
                }
            }


            steps {

                echo """
============================================================
CAG WEBSITE V2 - PUSH IMAGES TO DOCKER HUB
============================================================
"""


                withCredentials([

                    usernamePassword(

                        credentialsId: "${DOCKERHUB_CREDENTIALS_ID}",

                        usernameVariable: "DOCKERHUB_USERNAME",

                        passwordVariable: "DOCKERHUB_TOKEN"
                    )
                ]) {


                    sh '''
                        set -eu


                        echo "Logging into Docker Hub..."


                        echo "${DOCKERHUB_TOKEN}" | \
                            docker login \
                            --username "${DOCKERHUB_USERNAME}" \
                            --password-stdin


                        echo ""

                        echo "Pushing backend image:"


                        echo "${BACKEND_IMAGE}:${IMAGE_TAG}"


                        docker push \
                            "${BACKEND_IMAGE}:${IMAGE_TAG}"


                        echo ""

                        echo "Pushing frontend image:"


                        echo "${FRONTEND_IMAGE}:${IMAGE_TAG}"


                        docker push \
                            "${FRONTEND_IMAGE}:${IMAGE_TAG}"


                        echo ""

                        echo "Docker Hub push completed successfully."


                        echo ""

                        echo "Logging out from Docker Hub..."


                        docker logout \
                            || true
                    '''
                }
            }
        }


        /*
         * ============================================================
         * 16. PUBLISH BUILD INFORMATION
         * ============================================================
         */

        stage("16. Publish Build Information") {

            steps {

                echo """
============================================================
CAG WEBSITE V2 - BUILD INFORMATION
============================================================
"""


                sh '''
                    set -eu


                    cat > build-info.txt <<EOF

CAG Website V2 CI Build Information
===================================

Jenkins Build:
${BUILD_NUMBER}

Job:
${JOB_NAME}

Branch:
${BRANCH_NAME}

Pull Request:
${CHANGE_ID:-No}

Git Commit:
${GIT_COMMIT}

Git SHA:
${GIT_SHA}

Image Tag:
${IMAGE_TAG}

Backend Image:
${BACKEND_IMAGE}:${IMAGE_TAG}

Frontend Image:
${FRONTEND_IMAGE}:${IMAGE_TAG}

Backend Health Endpoint:
/health

Frontend Health Endpoint:
/

CI Docker Network:
${CI_NETWORK}

Production Database:
NOT USED

Production Deployment:
NOT PERFORMED BY CI

Build Date:
$(date -u '+%Y-%m-%d %H:%M:%S UTC')

EOF


                    echo ""

                    echo "==========================================="

                    echo "BUILD INFORMATION"

                    echo "==========================================="


                    cat build-info.txt
                '''


                archiveArtifacts(

                    artifacts: "build-info.txt",

                    fingerprint: true,

                    allowEmptyArchive: false
                )
            }
        }


        /*
         * ============================================================
         * 17. DEPLOY PROD
         * ============================================================
         */

        stage("17. Deploy Prod") {

            when {

                allOf {

                    branch "Prod"

                    not {
                        changeRequest()
                    }
                }
            }


            steps {

                echo """
============================================================
CAG WEBSITE V2 - PRODUCTION DEPLOYMENT
============================================================
"""


                script {

                    echo "Production deployment requested."


                    echo ""

                    echo "Git SHA:"
                    echo "${env.GIT_SHA}"


                    echo ""

                    echo "Backend:"
                    echo "${BACKEND_IMAGE}:${env.IMAGE_TAG}"


                    echo ""

                    echo "Frontend:"
                    echo "${FRONTEND_IMAGE}:${env.IMAGE_TAG}"


                    /*
                     * CD/Jenkinsfile must exist in Prod.
                     */

                    if (!fileExists("CD/Jenkinsfile")) {

                        error(
                            "PRODUCTION DEPLOYMENT BLOCKED: CD/Jenkinsfile was not found."
                        )
                    }


                    echo ""

                    echo "Loading CD/Jenkinsfile..."


                    def deployCD = load "CD/Jenkinsfile"


                    deployCD.deploy(

                        env.IMAGE_TAG,

                        env.BACKEND_IMAGE,

                        env.FRONTEND_IMAGE
                    )


                    echo ""

                    echo "Production deployment completed."
                }
            }
        }
    }


    /*
     * ================================================================
     * POST ACTIONS
     * ================================================================
     */

    post {


        /*
         * ============================================================
         * SUCCESS
         * ============================================================
         */

        success {

            script {

                echo """
============================================================
CAG WEBSITE V2 - CI PIPELINE SUCCESS
============================================================

Repository Validation       : PASSED
SonarQube Scan              : COMPLETED
Backend Docker Build        : PASSED
Frontend Docker Build       : PASSED
Trivy Backend Scan          : COMPLETED
Trivy Frontend Scan         : COMPLETED
PostgreSQL CI Test          : PASSED
Backend Health Check        : PASSED
Frontend Health Check       : PASSED
Filesystem Scan             : COMPLETED
Docker Hub Push             : COMPLETED

Git SHA:
${env.GIT_SHA}

Backend Image:
${BACKEND_IMAGE}:${env.IMAGE_TAG}

Frontend Image:
${FRONTEND_IMAGE}:${env.IMAGE_TAG}

============================================================
"""


                if (env.CHANGE_ID) {

                    echo ""

                    echo "Pull Request:"
                    echo "#${env.CHANGE_ID}"

                    echo ""

                    echo "PR CI validation completed successfully."
                }
            }
        }


        /*
         * ============================================================
         * FAILURE
         * ============================================================
         */

        failure {

            script {

                echo """
============================================================
CAG WEBSITE V2 - CI PIPELINE FAILED
============================================================

Build Number:
${BUILD_NUMBER}

Branch:
${env.BRANCH_NAME}

Git SHA:
${env.GIT_SHA ?: "unknown"}

============================================================

Please check the Jenkins Console Output.

IMPORTANT:

CI did NOT perform production deployment.

No production database was used by the CI test environment.

============================================================
"""


                if (env.CHANGE_ID) {

                    echo ""

                    echo "Pull Request:"
                    echo "#${env.CHANGE_ID}"

                    echo ""

                    echo "PR CI validation FAILED."

                    echo "Review the Jenkins console output."
                }
            }
        }


        /*
         * ============================================================
         * ALWAYS
         * ============================================================
         */

        always {

            script {

                echo """
============================================================
CAG WEBSITE V2 - POST BUILD ACTIONS
============================================================
"""


                /*
                 * Archive Trivy reports.
                 */

                echo "Archiving Trivy reports..."


                archiveArtifacts(

                    artifacts:
                        "trivy-backend-image-${BUILD_NUMBER}.txt," +
                        "trivy-frontend-image-${BUILD_NUMBER}.txt," +
                        "trivy-backend-rootfs-${BUILD_NUMBER}.txt",

                    allowEmptyArchive: true,

                    fingerprint: true
                )


                /*
                 * Cleanup CI resources.
                 */

                echo ""

                echo "Cleaning CI containers..."


                sh '''
                    set +e


                    echo ""

                    echo "Removing frontend CI container..."


                    docker rm -f \
                        "${FRONTEND_CONTAINER}" \
                        >/dev/null 2>&1 \
                        || true


                    echo ""

                    echo "Removing backend CI container..."


                    docker rm -f \
                        "${BACKEND_CONTAINER}" \
                        >/dev/null 2>&1 \
                        || true


                    echo ""

                    echo "Removing PostgreSQL CI container..."


                    docker rm -f \
                        "${POSTGRES_CONTAINER}" \
                        >/dev/null 2>&1 \
                        || true


                    echo ""

                    echo "Removing CI network..."


                    docker network rm \
                        "${CI_NETWORK}" \
                        >/dev/null 2>&1 \
                        || true


                    echo ""

                    echo "Removing temporary health files..."


                    rm -f \
                        /tmp/cag-website-v2-backend-health.json \
                        /tmp/cag-website-v2-frontend-health.html


                    echo ""

                    echo "Removing temporary backend filesystem..."


                    rm -rf \
                        "${WORKSPACE}/trivy-backend-rootfs"


                    echo ""

                    echo "Removing temporary backend tar..."


                    rm -f \
                        "${WORKSPACE}/backend-rootfs.tar"


                    echo ""

                    echo "CI container cleanup completed."


                    echo ""

                    echo "Remaining CAG Website V2 CI containers:"


                    docker ps -a \
                        --filter "name=cag-website-v2-ci-" \
                        || true


                    echo ""

                    echo "Remaining CAG Website V2 CI networks:"


                    docker network ls \
                        --filter "name=cag-website-v2-ci-" \
                        || true
                '''
            }
        }


        /*
         * ============================================================
         * CLEAN WORKSPACE
         * ============================================================
         */

        cleanup {

            echo """
============================================================
CAG WEBSITE V2 - CLEAN WORKSPACE
============================================================
"""


            cleanWs()
        }
    }
}