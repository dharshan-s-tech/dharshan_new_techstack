pipeline {
    agent any

    /*
     * ================================================================
     * CAG WEBSITE V2 - CI PIPELINE
     * ================================================================
     *
     * Flow:
     *
     * 1. Checkout Code
     * 2. Check Raw Files
     * 3. SonarQube Scan
     * 4. Create CI Network
     * 5. Start PostgreSQL
     * 6. Build Backend Docker Image
     * 7. Build Frontend Docker Image
     * 8. Trivy Backend Image Scan
     * 9. Trivy Frontend Image Scan
     * 10. Start Backend Test Container
     * 11. Backend Health Check
     * 12. Start Frontend Test Container
     * 13. Frontend Health Check
     * 14. Trivy Backend Filesystem Scan
     * 15. Push Images to Docker Hub
     * 16. Publish Build Information
     * 17. Deploy Prod
     *
     * IMPORTANT:
     * - CI never uses the production database.
     * - CI uses an isolated PostgreSQL container.
     * - CI builds Docker images.
     * - CI pushes immutable Git-SHA images to Docker Hub.
     * - CD will pull these exact images.
     * - CI does NOT modify application source code.
     * ================================================================
     */

    environment {

        /*
         * ------------------------------------------------------------
         * DOCKER HUB
         * ------------------------------------------------------------
         */
        DOCKERHUB_CREDENTIALS_ID = 'dockerhub-creds'

        BACKEND_IMAGE  = 'iitmpravartak/cag-website-v2-backend'
        FRONTEND_IMAGE = 'iitmpravartak/cag-website-v2-frontend'


        /*
         * ------------------------------------------------------------
         * GITHUB
         * ------------------------------------------------------------
         */
        GITHUB_CREDENTIALS_ID = 'github-token'


        /*
         * ------------------------------------------------------------
         * SONARQUBE
         * ------------------------------------------------------------
         */
        SONARQUBE_SERVER = 'sonar-server'
        SONAR_SCANNER    = 'SonarScanner'

        SONAR_PROJECT_KEY  = 'CAG_Website_V2'
        SONAR_PROJECT_NAME = 'CAG Website V2'


        /*
         * ------------------------------------------------------------
         * CI NETWORK
         * ------------------------------------------------------------
         *
         * Every Jenkins build gets its own isolated Docker network.
         * ------------------------------------------------------------
         */
        CI_NETWORK = "cag-website-v2-ci-${BUILD_NUMBER}"


        /*
         * ------------------------------------------------------------
         * CI CONTAINERS
         * ------------------------------------------------------------
         */
        POSTGRES_CONTAINER = "cag-website-v2-ci-postgres-${BUILD_NUMBER}"
        BACKEND_CONTAINER  = "cag-website-v2-ci-backend-${BUILD_NUMBER}"
        FRONTEND_CONTAINER = "cag-website-v2-ci-frontend-${BUILD_NUMBER}"


        /*
         * ------------------------------------------------------------
         * TEST POSTGRESQL
         * ------------------------------------------------------------
         *
         * These credentials are ONLY for CI testing.
         * They are NOT production credentials.
         * ------------------------------------------------------------
         */
        POSTGRES_IMAGE    = 'postgres:17'
        POSTGRES_DB       = 'cag_test'
        POSTGRES_USER     = 'cag_test'
        POSTGRES_PASSWORD = 'cag_test_password'


        /*
         * ------------------------------------------------------------
         * TRIVY
         * ------------------------------------------------------------
         */
        TRIVY_CACHE_DIR = "${WORKSPACE}/.trivy-cache"


        /*
         * ------------------------------------------------------------
         * APPLICATION PORTS
         * ------------------------------------------------------------
         */
        BACKEND_PORT  = '8000'
        FRONTEND_PORT = '3000'
    }


    stages {


        /*
         * ============================================================
         * 1. CHECKOUT CODE
         * ============================================================
         */
        stage('1. Checkout Code') {
            steps {
                script {
                    echo "============================================================"
                    echo "1. CHECKOUT CODE"
                    echo "============================================================"

                    checkout scm

                    sh '''
                        echo "Git remote:"
                        git remote -v

                        echo ""
                        echo "Current branch:"
                        git branch --show-current

                        echo ""
                        echo "Git commit:"
                        git rev-parse HEAD

                        echo ""
                        echo "Git short SHA:"
                        git rev-parse --short=12 HEAD
                    '''

                    env.GIT_SHA = sh(
                        script: 'git rev-parse --short=12 HEAD',
                        returnStdout: true
                    ).trim()

                    echo "Using Git SHA: ${env.GIT_SHA}"
                }
            }
        }


        /*
         * ============================================================
         * 2. CHECK RAW FILES
         * ============================================================
         */
        stage('2. Check Raw Files') {
            steps {
                script {
                    echo "============================================================"
                    echo "2. CHECK RAW FILES"
                    echo "============================================================"

                    sh '''
                        echo "Project root:"
                        pwd

                        echo ""
                        echo "Top-level files:"
                        find . -maxdepth 1 -type f -printf '%f\\n' | sort

                        echo ""
                        echo "Backend files:"
                        find back_end -maxdepth 3 -type f | sort || true

                        echo ""
                        echo "CI files:"
                        find CI -maxdepth 2 -type f | sort || true

                        echo ""
                        echo "Dockerfiles:"
                        find . -name "Dockerfile*" -type f -print

                        echo ""
                        echo "Docker Compose:"
                        find . -iname "*compose*.yml" -o -iname "*compose*.yaml"
                    '''

                    sh '''
                        echo ""
                        echo "Checking required project files..."

                        test -f Dockerfile
                        test -f docker-compose.yml
                        test -f package.json
                        test -f package-lock.json

                        test -f back_end/Dockerfile
                        test -f back_end/requirements.txt

                        echo "Required project files found."
                    '''
                }
            }
        }


        /*
         * ============================================================
         * 3. SONARQUBE SCAN
         * ============================================================
         */
        stage('3. SonarQube Scan') {
            steps {
                script {
                    echo "============================================================"
                    echo "3. SONARQUBE SCAN"
                    echo "============================================================"

                    withSonarQubeEnv("${SONARQUBE_SERVER}") {

                        sh """
                            ${SONAR_SCANNER}/bin/sonar-scanner \
                                -Dsonar.projectKey=${SONAR_PROJECT_KEY} \
                                -Dsonar.projectName="${SONAR_PROJECT_NAME}" \
                                -Dsonar.projectVersion=${env.GIT_SHA} \
                                -Dsonar.sources=. \
                                -Dsonar.exclusions="node_modules/**,.next/**,back_end/__pycache__/**,**/*.lock,public/**"
                        """
                    }

                    echo "SonarQube scan completed."
                }
            }
        }


        /*
         * ============================================================
         * 4. CREATE CI NETWORK
         * ============================================================
         */
        stage('4. Create CI Network') {
            steps {
                script {
                    echo "============================================================"
                    echo "4. CREATE CI NETWORK"
                    echo "============================================================"

                    sh '''
                        docker network create "${CI_NETWORK}" || true

                        echo ""
                        echo "CI network:"
                        docker network inspect "${CI_NETWORK}" --format '{{.Name}}'
                    '''
                }
            }
        }


        /*
         * ============================================================
         * 5. START POSTGRESQL
         * ============================================================
         *
         * The application expects PostgreSQL.
         *
         * CI MUST NOT connect to:
         *
         *     10.10.183.210:5433
         *
         * or any production database.
         *
         * Instead, the backend connects to this temporary PostgreSQL
         * container through the isolated CI network.
         * ============================================================
         */
        stage('5. Start PostgreSQL') {
            steps {
                script {
                    echo "============================================================"
                    echo "5. START POSTGRESQL"
                    echo "============================================================"

                    sh '''
                        docker run -d \
                            --name "${POSTGRES_CONTAINER}" \
                            --network "${CI_NETWORK}" \
                            -e POSTGRES_DB="${POSTGRES_DB}" \
                            -e POSTGRES_USER="${POSTGRES_USER}" \
                            -e POSTGRES_PASSWORD="${POSTGRES_PASSWORD}" \
                            "${POSTGRES_IMAGE}"

                        echo "Waiting for PostgreSQL..."

                        for i in $(seq 1 30); do
                            if docker exec "${POSTGRES_CONTAINER}" \
                                pg_isready \
                                -U "${POSTGRES_USER}" \
                                -d "${POSTGRES_DB}" >/dev/null 2>&1
                            then
                                echo "PostgreSQL is ready."
                                exit 0
                            fi

                            sleep 2
                        done

                        echo "PostgreSQL failed to become ready."
                        docker logs "${POSTGRES_CONTAINER}" || true
                        exit 1
                    '''
                }
            }
        }


        /*
         * ============================================================
         * 6. BUILD BACKEND DOCKER IMAGE
         * ============================================================
         */
        stage('6. Build Backend Docker Image') {
            steps {
                script {
                    echo "============================================================"
                    echo "6. BUILD BACKEND DOCKER IMAGE"
                    echo "============================================================"

                    sh """
                        docker build \
                            -f back_end/Dockerfile \
                            -t ${BACKEND_IMAGE}:${env.GIT_SHA} \
                            -t ${BACKEND_IMAGE}:ci-${BUILD_NUMBER} \
                            ./back_end
                    """

                    sh """
                        docker image inspect \
                            ${BACKEND_IMAGE}:${env.GIT_SHA} >/dev/null

                        echo "Backend image created:"
                        docker image inspect \
                            ${BACKEND_IMAGE}:${env.GIT_SHA} \
                            --format '{{.RepoTags}}'
                    """
                }
            }
        }


        /*
         * ============================================================
         * 7. BUILD FRONTEND DOCKER IMAGE
         * ============================================================
         *
         * The existing project Dockerfile performs:
         *
         *     npm ci
         *     npm run build
         *
         * Therefore TypeScript / Next.js build errors will correctly
         * fail this stage.
         *
         * We do NOT modify developer source code to bypass failures.
         * ============================================================
         */
        stage('7. Build Frontend Docker Image') {
            steps {
                script {
                    echo "============================================================"
                    echo "7. BUILD FRONTEND DOCKER IMAGE"
                    echo "============================================================"

                    sh """
                        docker build \
                            -f Dockerfile \
                            -t ${FRONTEND_IMAGE}:${env.GIT_SHA} \
                            -t ${FRONTEND_IMAGE}:ci-${BUILD_NUMBER} \
                            .
                    """

                    sh """
                        docker image inspect \
                            ${FRONTEND_IMAGE}:${env.GIT_SHA} >/dev/null

                        echo "Frontend image created:"
                        docker image inspect \
                            ${FRONTEND_IMAGE}:${env.GIT_SHA} \
                            --format '{{.RepoTags}}'
                    """
                }
            }
        }


        /*
         * ============================================================
         * 8. TRIVY BACKEND IMAGE SCAN
         * ============================================================
         */
        stage('8. Trivy Backend Image Scan') {
            steps {
                script {
                    echo "============================================================"
                    echo "8. TRIVY BACKEND IMAGE SCAN"
                    echo "============================================================"

                    sh """
                        mkdir -p "${TRIVY_CACHE_DIR}"

                        trivy image \
                            --cache-dir "${TRIVY_CACHE_DIR}" \
                            --format json \
                            --output trivy-backend-${BUILD_NUMBER}.json \
                            --exit-code 0 \
                            --severity HIGH,CRITICAL \
                            ${BACKEND_IMAGE}:${env.GIT_SHA}
                    """

                    echo "Backend Trivy scan completed."
                }
            }
        }


        /*
         * ============================================================
         * 9. TRIVY FRONTEND IMAGE SCAN
         * ============================================================
         */
        stage('9. Trivy Frontend Image Scan') {
            steps {
                script {
                    echo "============================================================"
                    echo "9. TRIVY FRONTEND IMAGE SCAN"
                    echo "============================================================"

                    sh """
                        mkdir -p "${TRIVY_CACHE_DIR}"

                        trivy image \
                            --cache-dir "${TRIVY_CACHE_DIR}" \
                            --format json \
                            --output trivy-frontend-${BUILD_NUMBER}.json \
                            --exit-code 0 \
                            --severity HIGH,CRITICAL \
                            ${FRONTEND_IMAGE}:${env.GIT_SHA}
                    """

                    echo "Frontend Trivy scan completed."
                }
            }
        }


        /*
         * ============================================================
         * 10. START BACKEND TEST CONTAINER
         * ============================================================
         *
         * Backend configuration:
         *
         * DB_HOST=postgres
         * DB_PORT=5432
         * DB_NAME=cag_test
         * DB_USER=cag_test
         * DB_PASSWORD=cag_test_password
         * DB_SCHEMA=cag_test
         *
         * This matches the application's Settings class.
         * ============================================================
         */
        stage('10. Start Backend Test Container') {
            steps {
                script {
                    echo "============================================================"
                    echo "10. START BACKEND TEST CONTAINER"
                    echo "============================================================"

                    sh """
                        docker run -d \
                            --name "${BACKEND_CONTAINER}" \
                            --network "${CI_NETWORK}" \
                            -e ENVIRONMENT=testing \
                            -e DB_HOST=postgres \
                            -e DB_PORT=5432 \
                            -e DB_NAME="${POSTGRES_DB}" \
                            -e DB_USER="${POSTGRES_USER}" \
                            -e DB_PASSWORD="${POSTGRES_PASSWORD}" \
                            -e DB_SCHEMA=cag_test \
                            -e DATABASE_URL="postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}" \
                            -p 127.0.0.1:${BACKEND_PORT}:${BACKEND_PORT} \
                            ${BACKEND_IMAGE}:${env.GIT_SHA}
                    """

                    sleep 5

                    sh """
                        echo "Backend container status:"
                        docker ps -a \
                            --filter "name=${BACKEND_CONTAINER}"

                        echo ""
                        echo "Backend logs:"
                        docker logs "${BACKEND_CONTAINER}" || true
                    """
                }
            }
        }


        /*
         * ============================================================
         * 11. BACKEND HEALTH CHECK
         * ============================================================
         *
         * IMPORTANT:
         *
         * Current FastAPI code exposes:
         *
         *     GET /health
         *
         * NOT:
         *
         *     /api/health
         * ============================================================
         */
        stage('11. Backend Health Check') {
            steps {
                script {
                    echo "============================================================"
                    echo "11. BACKEND HEALTH CHECK"
                    echo "============================================================"

                    sh '''
                        echo "Waiting for backend..."

                        for i in $(seq 1 30); do

                            if docker run --rm \
                                --network "${CI_NETWORK}" \
                                curlimages/curl:8.11.1 \
                                -fsS \
                                http://${BACKEND_CONTAINER}:8000/health
                            then
                                echo ""
                                echo "Backend health check PASSED."
                                exit 0
                            fi

                            echo "Backend not ready. Attempt ${i}/30"
                            sleep 2
                        done

                        echo ""
                        echo "Backend health check FAILED."

                        echo ""
                        echo "Backend container:"
                        docker ps -a \
                            --filter "name=${BACKEND_CONTAINER}"

                        echo ""
                        echo "Backend logs:"
                        docker logs "${BACKEND_CONTAINER}" || true

                        exit 1
                    '''
                }
            }
        }


        /*
         * ============================================================
         * 12. START FRONTEND TEST CONTAINER
         * ============================================================
         */
        stage('12. Start Frontend Test Container') {
            steps {
                script {
                    echo "============================================================"
                    echo "12. START FRONTEND TEST CONTAINER"
                    echo "============================================================"

                    sh """
                        docker run -d \
                            --name "${FRONTEND_CONTAINER}" \
                            --network "${CI_NETWORK}" \
                            -e NODE_ENV=production \
                            -e NEXT_PUBLIC_API_URL=http://${BACKEND_CONTAINER}:8000 \
                            -p 127.0.0.1:${FRONTEND_PORT}:${FRONTEND_PORT} \
                            ${FRONTEND_IMAGE}:${env.GIT_SHA}
                    """

                    sleep 5

                    sh """
                        echo "Frontend container status:"
                        docker ps -a \
                            --filter "name=${FRONTEND_CONTAINER}"

                        echo ""
                        echo "Frontend logs:"
                        docker logs "${FRONTEND_CONTAINER}" || true
                    """
                }
            }
        }


        /*
         * ============================================================
         * 13. FRONTEND HEALTH CHECK
         * ============================================================
         */
        stage('13. Frontend Health Check') {
            steps {
                script {
                    echo "============================================================"
                    echo "13. FRONTEND HEALTH CHECK"
                    echo "============================================================"

                    sh '''
                        echo "Waiting for frontend..."

                        for i in $(seq 1 30); do

                            if docker run --rm \
                                --network "${CI_NETWORK}" \
                                curlimages/curl:8.11.1 \
                                -fsS \
                                http://${FRONTEND_CONTAINER}:3000/
                            then
                                echo ""
                                echo "Frontend health check PASSED."
                                exit 0
                            fi

                            echo "Frontend not ready. Attempt ${i}/30"
                            sleep 2
                        done

                        echo ""
                        echo "Frontend health check FAILED."

                        echo ""
                        echo "Frontend container:"
                        docker ps -a \
                            --filter "name=${FRONTEND_CONTAINER}"

                        echo ""
                        echo "Frontend logs:"
                        docker logs "${FRONTEND_CONTAINER}" || true

                        exit 1
                    '''
                }
            }
        }


        /*
         * ============================================================
         * 14. TRIVY BACKEND FILESYSTEM SCAN
         * ============================================================
         */
        stage('14. Trivy Backend Filesystem Scan') {
            steps {
                script {
                    echo "============================================================"
                    echo "14. TRIVY BACKEND FILESYSTEM SCAN"
                    echo "============================================================"

                    sh """
                        rm -rf trivy-backend-fs
                        mkdir -p trivy-backend-fs

                        docker export "${BACKEND_CONTAINER}" \
                            -o backend-container.tar

                        tar -xf backend-container.tar \
                            -C trivy-backend-fs

                        trivy fs \
                            --cache-dir "${TRIVY_CACHE_DIR}" \
                            --format json \
                            --output trivy-backend-fs-${BUILD_NUMBER}.json \
                            --exit-code 0 \
                            --severity HIGH,CRITICAL \
                            trivy-backend-fs

                        rm -f backend-container.tar
                        rm -rf trivy-backend-fs
                    """

                    echo "Backend filesystem scan completed."
                }
            }
        }


        /*
         * ============================================================
         * 15. PUSH IMAGES TO DOCKER HUB
         * ============================================================
         *
         * Images are pushed only for:
         *
         *     Dev
         *     Prod
         *     Pull Requests
         *
         * The immutable tag is the 12-character Git SHA.
         *
         * Example:
         *
         *     iitmpravartak/cag-website-v2-backend:6a8c8df12345
         *
         *     iitmpravartak/cag-website-v2-frontend:6a8c8df12345
         * ============================================================
         */
        stage('15. Push Images to Docker Hub') {
            when {
                anyOf {
                    branch 'Dev'
                    branch 'Prod'
                    changeRequest()
                }
            }

            steps {
                script {
                    echo "============================================================"
                    echo "15. PUSH IMAGES TO DOCKER HUB"
                    echo "============================================================"

                    withCredentials([
                        usernamePassword(
                            credentialsId: "${DOCKERHUB_CREDENTIALS_ID}",
                            usernameVariable: 'DOCKER_USERNAME',
                            passwordVariable: 'DOCKER_PASSWORD'
                        )
                    ]) {

                        sh '''
                            echo "${DOCKER_PASSWORD}" | docker login \
                                -u "${DOCKER_USERNAME}" \
                                --password-stdin
                        '''

                        sh """
                            docker push ${BACKEND_IMAGE}:${env.GIT_SHA}
                            docker push ${FRONTEND_IMAGE}:${env.GIT_SHA}
                        """

                        sh '''
                            docker logout
                        '''
                    }

                    echo "Docker Hub push completed."
                }
            }
        }


        /*
         * ============================================================
         * 16. PUBLISH BUILD INFORMATION
         * ============================================================
         *
         * IMPORTANT:
         *
         * This shell block uses single-quoted Groovy strings so that
         * Linux shell variables such as ${BUILD_NUMBER} and
         * $(date ...) are NOT interpreted by Groovy.
         * ============================================================
         */
        stage('16. Publish Build Information') {
            steps {
                script {
                    echo "============================================================"
                    echo "16. PUBLISH BUILD INFORMATION"
                    echo "============================================================"

                    sh '''
                        cat > build-info.txt <<EOF
CAG Website V2 CI Build Information
===================================

Jenkins Build:
${BUILD_NUMBER}

Git SHA:
${GIT_SHA}

Branch:
${BRANCH_NAME}

Backend Image:
${BACKEND_IMAGE}:${GIT_SHA}

Frontend Image:
${FRONTEND_IMAGE}:${GIT_SHA}

Backend Health Endpoint:
/health

Frontend Health Endpoint:
/

Docker Network:
${CI_NETWORK}

Build Date:
$(date -u '+%Y-%m-%d %H:%M:%S UTC')
EOF

                        cat build-info.txt
                    '''

                    archiveArtifacts artifacts: 'build-info.txt', fingerprint: true
                }
            }
        }


        /*
         * ============================================================
         * 17. DEPLOY PROD
         * ============================================================
         *
         * IMPORTANT:
         *
         * CI builds and pushes the images.
         *
         * CD will:
         *
         *     1. Receive the exact Git SHA
         *     2. SSH to AWS
         *     3. Pull the exact Docker images
         *     4. Verify the images
         *     5. Start the backend
         *     6. Health-check backend
         *     7. Start the frontend
         *     8. Health-check frontend
         *
         * CD will NOT run docker build.
         * ============================================================
         */
        stage('17. Deploy Prod') {
            when {
                branch 'Prod'
            }

            steps {
                script {
                    echo "============================================================"
                    echo "17. DEPLOY PROD"
                    echo "============================================================"

                    echo "Production deployment requested."
                    echo "Git SHA: ${env.GIT_SHA}"

                    /*
                     * CD/Jenkinsfile will be added separately.
                     *
                     * It will deploy:
                     *
                     * ${BACKEND_IMAGE}:${env.GIT_SHA}
                     * ${FRONTEND_IMAGE}:${env.GIT_SHA}
                     */

                    def deployCD = load 'CD/Jenkinsfile'

                    deployCD.deploy(
                        env.GIT_SHA,
                        env.BACKEND_IMAGE,
                        env.FRONTEND_IMAGE
                    )
                }
            }
        }
    }


    /*
     * ================================================================
     * POST ACTIONS
     * ================================================================
     */
    post {

        /*
         * ------------------------------------------------------------
         * SUCCESS
         * ------------------------------------------------------------
         */
        success {
            script {

                echo "============================================================"
                echo "CI PIPELINE SUCCESS"
                echo "============================================================"

                echo ""
                echo "CAG Website V2 CI completed successfully."
                echo ""
                echo "Git SHA:"
                echo "${env.GIT_SHA}"
                echo ""
                echo "Backend:"
                echo "${BACKEND_IMAGE}:${env.GIT_SHA}"
                echo ""
                echo "Frontend:"
                echo "${FRONTEND_IMAGE}:${env.GIT_SHA}"
                echo ""

                /*
                 * GitHub PR success information
                 */
                if (env.CHANGE_ID) {

                    echo "PR build completed successfully."
                    echo "GitHub PR:"
                    echo "${env.CHANGE_URL}"
                }
            }
        }


        /*
         * ------------------------------------------------------------
         * FAILURE
         * ------------------------------------------------------------
         */
        failure {
            script {

                echo "============================================================"
                echo "CI PIPELINE FAILED"
                echo "============================================================"

                echo ""
                echo "CAG Website V2 CI failed."
                echo "Build Number: ${BUILD_NUMBER}"
                echo "Git SHA: ${env.GIT_SHA ?: 'unknown'}"

                /*
                 * GitHub PR failure information
                 */
                if (env.CHANGE_ID) {

                    echo ""
                    echo "This build belongs to Pull Request #${env.CHANGE_ID}."
                    echo "Please review the Jenkins console output."
                }
            }
        }


        /*
         * ------------------------------------------------------------
         * ALWAYS - TRIVY REPORTS
         * ------------------------------------------------------------
         */
        always {
            script {

                echo "============================================================"
                echo "ARCHIVING SECURITY REPORTS"
                echo "============================================================"

                archiveArtifacts(
                    artifacts: 'trivy-*.json',
                    allowEmptyArchive: true,
                    fingerprint: true
                )
            }
        }


        /*
         * ------------------------------------------------------------
         * ALWAYS - CLEANUP
         * ------------------------------------------------------------
         *
         * Only containers/network created by THIS BUILD are removed.
         *
         * No global Docker cleanup is performed.
         *
         * We do NOT use:
         *
         *     docker system prune
         *     docker volume prune
         *     docker compose down
         *
         * against any production environment.
         * ------------------------------------------------------------
         */
        always {
            script {

                echo "============================================================"
                echo "CLEANING CI RESOURCES"
                echo "============================================================"

                sh '''
                    set +e

                    echo "Stopping frontend test container..."
                    docker rm -f "${FRONTEND_CONTAINER}" 2>/dev/null || true

                    echo "Stopping backend test container..."
                    docker rm -f "${BACKEND_CONTAINER}" 2>/dev/null || true

                    echo "Stopping PostgreSQL test container..."
                    docker rm -f "${POSTGRES_CONTAINER}" 2>/dev/null || true

                    echo "Removing CI network..."
                    docker network rm "${CI_NETWORK}" 2>/dev/null || true

                    echo "Removing temporary CI images..."

                    docker image rm \
                        "${BACKEND_IMAGE}:ci-${BUILD_NUMBER}" \
                        2>/dev/null || true

                    docker image rm \
                        "${FRONTEND_IMAGE}:ci-${BUILD_NUMBER}" \
                        2>/dev/null || true

                    echo "CI resource cleanup completed."
                '''
            }
        }


        /*
         * ------------------------------------------------------------
         * CLEAN WORKSPACE
         * ------------------------------------------------------------
         */
        cleanup {
            script {

                echo "============================================================"
                echo "CLEANING WORKSPACE"
                echo "============================================================"

                deleteDir()

                echo "Workspace cleanup completed."
            }
        }
    }
}