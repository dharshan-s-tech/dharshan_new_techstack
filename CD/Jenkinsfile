pipeline {
    agent any

    // ============================================================
    // IMAGE TO DEPLOY
    // ============================================================
    parameters {
        string(
            name: 'IMAGE_TAG',
            defaultValue: '',
            description: 'Exact 40-character Git SHA tag pushed by the successful CI build'
        )
    }

    environment {

        // ========================================================
        // Docker Hub
        // ========================================================
        DOCKER_CREDENTIALS = 'dockerhub-creds'

        BACKEND_IMAGE  = 'iitmpravartak/cag-website-v2-backend'
        FRONTEND_IMAGE = 'iitmpravartak/cag-website-v2-frontend'

        // ========================================================
        // AWS
        // ========================================================
        AWS_HOST = '13.202.245.81'
        AWS_USER = 'ubuntu'

        AWS_SSH_CREDENTIALS = 'cag-website-v2-aws-ssh'

        // ========================================================
        // AWS deployment directory
        // ========================================================
        DEPLOY_DIR = '/home/ubuntu/cag_website_v2'
    }

    stages {

        // ========================================================
        // 1. VALIDATE IMAGE TAG
        // ========================================================
        stage('Validate Image Tag') {
            steps {
                script {

                    def tag = params.IMAGE_TAG?.trim()

                    if (!tag) {
                        error(
                            'IMAGE_TAG is required. Enter the exact 40-character Git SHA from a successful CI build.'
                        )
                    }

                    if (!(tag ==~ /^[0-9a-fA-F]{40}$/)) {
                        error(
                            "Invalid IMAGE_TAG: ${tag}. Expected a 40-character Git SHA."
                        )
                    }

                    env.DEPLOY_TAG = tag.toLowerCase()

                    echo "=============================================="
                    echo "CD IMAGE TAG"
                    echo "=============================================="

                    echo ""
                    echo "Deploy tag:"
                    echo "${env.DEPLOY_TAG}"

                    echo ""
                    echo "Backend image:"
                    echo "${BACKEND_IMAGE}:${env.DEPLOY_TAG}"

                    echo ""
                    echo "Frontend image:"
                    echo "${FRONTEND_IMAGE}:${env.DEPLOY_TAG}"
                }
            }
        }

        // ========================================================
        // 2. DEPLOY DIRECTLY TO AWS
        // ========================================================
        stage('Deploy to AWS') {

            steps {

                withCredentials([
                    usernamePassword(
                        credentialsId: "${DOCKER_CREDENTIALS}",
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    ),

                    sshUserPrivateKey(
                        credentialsId: "${AWS_SSH_CREDENTIALS}",
                        keyFileVariable: 'SSH_KEY',
                        usernameVariable: 'SSH_USER'
                    )
                ]) {

                    sh '''
                        set -e

                        echo "=============================================="
                        echo "AWS DEPLOYMENT"
                        echo "=============================================="

                        echo ""
                        echo "AWS host:"
                        echo "${AWS_HOST}"

                        echo ""
                        echo "AWS user:"
                        echo "${SSH_USER}"

                        echo ""
                        echo "Deployment directory:"
                        echo "${DEPLOY_DIR}"

                        echo ""
                        echo "Image tag:"
                        echo "${DEPLOY_TAG}"

                        chmod 600 "${SSH_KEY}"

                        echo ""
                        echo "Testing SSH connection..."

                        ssh \
                            -o StrictHostKeyChecking=no \
                            -o ConnectTimeout=10 \
                            -o IdentitiesOnly=yes \
                            -i "${SSH_KEY}" \
                            "${SSH_USER}@${AWS_HOST}" \
                            "echo 'AWS SSH connection successful'"

                        echo ""
                        echo "SSH connection successful."

                        echo ""
                        echo "Starting deployment on AWS..."

                        ssh \
                            -o StrictHostKeyChecking=no \
                            -o ConnectTimeout=10 \
                            -o IdentitiesOnly=yes \
                            -i "${SSH_KEY}" \
                            "${SSH_USER}@${AWS_HOST}" \
                            "DOCKER_USERNAME='${DOCKER_USERNAME}' DOCKER_PASSWORD='${DOCKER_PASSWORD}' DEPLOY_TAG='${DEPLOY_TAG}' DEPLOY_DIR='${DEPLOY_DIR}' bash -s" <<'REMOTE_SCRIPT'

set -e

echo "=============================================="
echo "AWS PRODUCTION DEPLOYMENT"
echo "=============================================="

echo ""
echo "Hostname:"
hostname

echo ""
echo "Deployment directory:"
echo "${DEPLOY_DIR}"

cd "${DEPLOY_DIR}"

echo ""
echo "Current directory:"
pwd

echo ""
echo "Docker version:"
docker --version

echo ""
echo "Docker Compose version:"
docker compose version

# ============================================================
# Docker Hub login
# ============================================================

echo ""
echo "Logging into Docker Hub..."

echo "${DOCKER_PASSWORD}" | docker login \
    --username "${DOCKER_USERNAME}" \
    --password-stdin

echo "Docker Hub login successful."

# ============================================================
# Pull exact CI images DIRECTLY ON AWS
# ============================================================

echo ""
echo "=============================================="
echo "PULL BACKEND IMAGE"
echo "=============================================="

docker pull \
    "iitmpravartak/cag-website-v2-backend:${DEPLOY_TAG}"

echo ""
echo "Backend image pulled successfully."

echo ""
echo "=============================================="
echo "PULL FRONTEND IMAGE"
echo "=============================================="

docker pull \
    "iitmpravartak/cag-website-v2-frontend:${DEPLOY_TAG}"

echo ""
echo "Frontend image pulled successfully."

# ============================================================
# Verify pulled image tags on AWS
# ============================================================

echo ""
echo "=============================================="
echo "VERIFY PULLED IMAGES"
echo "=============================================="

echo ""
echo "Backend image:"

docker image inspect \
    "iitmpravartak/cag-website-v2-backend:${DEPLOY_TAG}" \
    --format '{{.RepoTags}}'

echo ""
echo "Backend platform:"

docker image inspect \
    "iitmpravartak/cag-website-v2-backend:${DEPLOY_TAG}" \
    --format '{{.Os}}/{{.Architecture}}'

echo ""
echo "Frontend image:"

docker image inspect \
    "iitmpravartak/cag-website-v2-frontend:${DEPLOY_TAG}" \
    --format '{{.RepoTags}}'

echo ""
echo "Frontend platform:"

docker image inspect \
    "iitmpravartak/cag-website-v2-frontend:${DEPLOY_TAG}" \
    --format '{{.Os}}/{{.Architecture}}'

# ============================================================
# Deploy using production Compose
# ============================================================

echo ""
echo "=============================================="
echo "START PRODUCTION APPLICATION"
echo "=============================================="

export DEPLOY_TAG="${DEPLOY_TAG}"

echo ""
echo "Using image tag:"
echo "${DEPLOY_TAG}"

echo ""
echo "Docker Compose configuration:"

docker compose \
    -f docker-compose.yml \
    config

echo ""
echo "Starting containers..."

docker compose \
    -f docker-compose.yml \
    up -d \
    --remove-orphans

echo ""
echo "Docker Compose deployment completed."

# ============================================================
# Show running containers
# ============================================================

echo ""
echo "=============================================="
echo "RUNNING CONTAINERS"
echo "=============================================="

docker compose \
    -f docker-compose.yml \
    ps

# ============================================================
# Verify exact image used by containers
# ============================================================

echo ""
echo "=============================================="
echo "VERIFY DEPLOYED IMAGES"
echo "=============================================="

BACKEND_RUNNING_IMAGE=$(docker compose \
    -f docker-compose.yml \
    ps -q api | xargs docker inspect --format '{{.Config.Image}}')

FRONTEND_RUNNING_IMAGE=$(docker compose \
    -f docker-compose.yml \
    ps -q web | xargs docker inspect --format '{{.Config.Image}}')

echo ""
echo "Running backend image:"
echo "${BACKEND_RUNNING_IMAGE}"

echo ""
echo "Running frontend image:"
echo "${FRONTEND_RUNNING_IMAGE}"

echo ""
echo "Expected backend:"
echo "iitmpravartak/cag-website-v2-backend:${DEPLOY_TAG}"

echo ""
echo "Expected frontend:"
echo "iitmpravartak/cag-website-v2-frontend:${DEPLOY_TAG}"

if [ "${BACKEND_RUNNING_IMAGE}" != \
    "iitmpravartak/cag-website-v2-backend:${DEPLOY_TAG}" ]; then

    echo ""
    echo "ERROR: Backend image mismatch."

    docker compose \
        -f docker-compose.yml \
        ps

    exit 1
fi

if [ "${FRONTEND_RUNNING_IMAGE}" != \
    "iitmpravartak/cag-website-v2-frontend:${DEPLOY_TAG}" ]; then

    echo ""
    echo "ERROR: Frontend image mismatch."

    docker compose \
        -f docker-compose.yml \
        ps

    exit 1
fi

echo ""
echo "Exact image verification PASSED."

# ============================================================
# Deployment health checks
# ============================================================

echo ""
echo "=============================================="
echo "DEPLOYMENT HEALTH CHECKS"
echo "=============================================="

# ------------------------------------------------------------
# Frontend
# ------------------------------------------------------------

echo ""
echo "Checking frontend on port 3000..."

for i in $(seq 1 30); do

    if curl \
        --fail \
        --silent \
        --show-error \
        --max-time 5 \
        "http://127.0.0.1:3000" \
        >/tmp/cag-website-v2-frontend-health.log 2>&1
    then

        echo ""
        echo "Frontend health check PASSED."

        cat /tmp/cag-website-v2-frontend-health.log

        break
    fi

    echo "Frontend health check attempt ${i}/30 failed."

    if [ "${i}" -eq 30 ]; then

        echo ""
        echo "Frontend health check FAILED."

        echo ""
        echo "Compose status:"

        docker compose \
            -f docker-compose.yml \
            ps

        echo ""
        echo "Frontend logs:"

        docker compose \
            -f docker-compose.yml \
            logs \
            --tail=100 \
            web || true

        exit 1
    fi

    sleep 2
done

# ------------------------------------------------------------
# Backend
# ------------------------------------------------------------

echo ""
echo "Checking backend health on port 8000..."

for i in $(seq 1 30); do

    if curl \
        --fail \
        --silent \
        --show-error \
        --max-time 5 \
        "http://127.0.0.1:8000/health" \
        >/tmp/cag-website-v2-backend-health.log 2>&1
    then

        echo ""
        echo "Backend health check PASSED."

        cat /tmp/cag-website-v2-backend-health.log

        break
    fi

    echo "Backend health check attempt ${i}/30 failed."

    if [ "${i}" -eq 30 ]; then

        echo ""
        echo "Backend health check FAILED."

        echo ""
        echo "Compose status:"

        docker compose \
            -f docker-compose.yml \
            ps

        echo ""
        echo "Backend logs:"

        docker compose \
            -f docker-compose.yml \
            logs \
            --tail=100 \
            api || true

        exit 1
    fi

    sleep 2
done

# ============================================================
# Docker Hub logout
# ============================================================

echo ""
echo "Logging out from Docker Hub..."

docker logout || true

# ============================================================
# FINAL RESULT
# ============================================================

echo ""
echo "=============================================="
echo "AWS DEPLOYMENT SUCCESS"
echo "=============================================="

echo ""
echo "Backend:"
echo "iitmpravartak/cag-website-v2-backend:${DEPLOY_TAG}"

echo ""
echo "Frontend:"
echo "iitmpravartak/cag-website-v2-frontend:${DEPLOY_TAG}"

echo ""
echo "Frontend URL:"
echo "http://13.202.245.81:3000"

echo ""
echo "Backend health URL:"
echo "http://13.202.245.81:8000/health"

REMOTE_SCRIPT

                        echo ""
                        echo "=============================================="
                        echo "AWS DEPLOYMENT FINISHED"
                        echo "=============================================="
                    '''
                }
            }
        }

        // ========================================================
        // 3. DEPLOYMENT INFORMATION
        // ========================================================
        stage('Deployment Information') {
            steps {

                echo "=============================================="
                echo "PRODUCTION DEPLOYMENT COMPLETED"
                echo "=============================================="

                echo ""
                echo "AWS:"
                echo "${AWS_HOST}"

                echo ""
                echo "Image tag:"
                echo "${env.DEPLOY_TAG}"

                echo ""
                echo "Backend:"
                echo "${BACKEND_IMAGE}:${env.DEPLOY_TAG}"

                echo ""
                echo "Frontend:"
                echo "${FRONTEND_IMAGE}:${env.DEPLOY_TAG}"

                echo ""
                echo "Frontend URL:"
                echo "http://${AWS_HOST}:3000"

                echo ""
                echo "Backend health:"
                echo "http://${AWS_HOST}:8000/health"
            }
        }
    }

    // ============================================================
    // POST ACTIONS
    // ============================================================
    post {

        success {

            echo "=============================================="
            echo "CD PIPELINE SUCCESS"
            echo "=============================================="

            echo ""
            echo "AWS production deployment successful."

            echo ""
            echo "Image tag:"
            echo "${env.DEPLOY_TAG}"
        }

        failure {

            echo "=============================================="
            echo "CD PIPELINE FAILED"
            echo "=============================================="

            echo ""
            echo "AWS production deployment failed."

            echo ""
            echo "Image tag:"
            echo "${params.IMAGE_TAG}"
        }

        always {

            echo "=============================================="
            echo "CD PIPELINE FINISHED"
            echo "=============================================="
        }
    }
}